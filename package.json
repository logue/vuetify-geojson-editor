{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vuetify-geojson-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Vuetify GeoJson Editor",
  "homepage": "https://github.com/logue/vuetify-geojson-editor",
  "bugs": {
    "url": "https://github.com/logue/vuetify-geojson-editor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vuetify-geojson-editor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:analyze": "vite build --mode analyze",
    "build:clean": "rimraf dist",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.vite node_modules/.vite-tmp",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@mdi/font": "^7.4.47",
    "@turf/clean-coords": "^7.4.0",
    "@turf/rewind": "^7.4.0",
    "chroma-js": "^3.2.0",
    "core-js": "^3.50.0",
    "es-toolkit": "^1.52.0",
    "geojson-precision-ts": "^1.6.1",
    "json-url": "^4.0.0",
    "ol": "^10.11.0",
    "ol-ext": "^4.0.38",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "streamsaver": "^2.0.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "uuid": "^14.0.2",
    "vue": "^3.5.43",
    "vue-codemirror6": "^1.7.0",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/chroma-js": "^3.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.8",
    "@types/streamsaver": "^2.0.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-specification": "^1.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@12.9.1",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
